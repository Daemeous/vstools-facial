{
  "name": "vstools-facial",
  "version": "0.2.0",
  "description": "Vagrant Story model viewer with ESQ event animations, ETM facial textures and palette-aware PNG export.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --single-quote --write src/*.js test/*.js",
    "test": "node --loader ./test/loader.js --test test/facial.test.mjs",
    "serve": "http-server -c-1",
    "test:legacy": "node --experimental-loader ./test/loader.js test/test.js",
    "test:disc": "node --loader ./test/loader.js test/disc-facial.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daemeous/vstools-facial.git"
  },
  "author": "Morris Brodersen <mb@morrisbrodersen.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Daemeous/vstools-facial/issues"
  },
  "homepage": "https://github.com/Daemeous/vstools-facial",
  "dependencies": {
    "pngjs": "^5.0.0",
    "three": "^0.125.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "http-server": "^14.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
